# Dependencies (already excluded by default, but explicit)
node_modules/
yarn.lock
package-lock.json

# Git files
.git/
.gitignore
.gitattributes

# Documentation
docs/
README*.md
DEPLOYMENT.md
*.md

# Development files
.expo/
dist/
web-build/
*.log
.DS_Store

# Test files
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
.nyc_output/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Build artifacts
*.tsbuildinfo
build/
*.orig.*

# Environment files (keep .env but not local variants)
.env*.local

# Temporary files
tmp/
temp/
*.tmp

# Native build files
android/
ios/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Metro
.metro-health-check*

# Debug files
npm-debug.*
yarn-debug.*
yarn-error.*

